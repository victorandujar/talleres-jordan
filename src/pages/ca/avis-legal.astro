---
import Legal from '../../layouts/Legal.astro';
import { empresa } from '../../data/empresa';
---
<Legal title="Avís legal" lang="ca" alternates={{ es: '/aviso-legal', ca: '/ca/avis-legal' }}>
  <h2>Titular del lloc web</h2>
  <p>{empresa.nameCa} · NIF: <mark>pendent</mark><br />{empresa.street}, {empresa.area}, {empresa.postalCode} {empresa.city} ({empresa.region}) · Telèfon: {empresa.phone.display} · Email: {empresa.email}</p>
  <h2>Propietat intel·lectual</h2>
  <p>El logotip pertany a {empresa.nameCa}. Les il·lustracions són pròpies d’aquest web. Magneti Marelli i Checkstar són marques dels seus respectius titulars.</p>
</Legal>
