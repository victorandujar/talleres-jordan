---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].para;
---
<section id="para" aria-labelledby="para-t" class="scroll-mt-16 bg-white">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-28">
    <p class="label text-blau" data-reveal>{tx.label}</p>
    <h2 id="para-t" class="titol mt-4 max-w-4xl text-[clamp(2.5rem,5.6vw,5rem)]" data-reveal style="--i:1">{tx.title}</h2>
    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {tx.items.map((it, i) => (
        <li class="border-t-4 border-nit pt-6" data-reveal style={`--i:${i}`}>
          <span aria-hidden="true" class="titol text-6xl text-blau/20">0{i + 1}</span>
          <h3 class="titol mt-2 text-3xl">{it.t}</h3>
          <p class="mt-3 max-w-sm text-gris">{it.d}</p>
        </li>
      ))}
    </ol>
    <p class="mt-16 inline-flex items-center gap-3 rounded-full border-2 border-nit px-5 py-2.5 font-semibold" data-reveal>
      <svg viewBox="0 0 24 24" class="size-5 text-groc-2" aria-hidden="true"><path fill="currentColor" d="m12 2 2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7z" /></svg>
      {tx.red}
    </p>
  </div>
</section>
