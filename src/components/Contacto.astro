---
import { empresa, mailUrl, telUrl } from '../data/empresa';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].contacto;
---
<section id="contacto" aria-labelledby="cont-t" class="plano scroll-mt-16 text-white">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-20 sm:px-8 sm:py-28 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-6">
      <p class="label text-groc" data-reveal>{tx.label}</p>
      <h2 id="cont-t" class="titol mt-4 text-[clamp(3rem,7vw,6.4rem)]" data-reveal style="--i:1">{tx.title}</h2>
      <p class="mt-6 max-w-md text-lg text-white/75" data-reveal style="--i:2">{tx.text}</p>
      <address class="mt-10 not-italic text-xl" data-reveal style="--i:3">
        <span class="label block text-white/60">{tx.zona}</span>
        <span class="mt-2 block">{empresa.street}<br />{empresa.postalCode} {empresa.city}</span>
        <a href={empresa.maps} target="_blank" rel="noopener" class="mt-4 block w-fit border-b-2 border-groc pb-1 font-semibold">{tx.llegar} ↗</a>
      </address>
    </div>
    <div class="grid min-w-0 content-start gap-3 lg:col-span-5 lg:col-start-8">
      <a href={telUrl} class="group flex items-center justify-between gap-4 rounded-lg bg-groc p-6 text-nit" data-reveal>
        <span><span class="label block text-nit/70">{tx.tel}</span><span class="titol mt-1 block text-4xl tabular-nums">{empresa.phone.display}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={mailUrl(tx.asunto)} class="group flex min-w-0 items-center justify-between gap-4 rounded-lg border-2 border-white/30 p-6 hover:border-white" data-reveal style="--i:1">
        <span class="min-w-0"><span class="label block text-white/60">{tx.email}</span><span class="mt-1 block truncate text-xl font-semibold">{empresa.email}</span></span>
        <span aria-hidden="true" class="text-2xl">→</span>
      </a>
    </div>
  </div>
</section>
