---
import { empresa } from '../data/empresa';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const data = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: empresa.name,
  alternateName: empresa.nameCa,
  description: ui[lang].meta.description,
  inLanguage: lang,
  url: Astro.site?.href,
  telephone: empresa.phone.e164,
  email: empresa.email,
  address: { '@type': 'PostalAddress', streetAddress: `${empresa.street}, ${empresa.area}`, postalCode: empresa.postalCode, addressLocality: empresa.city, addressRegion: empresa.region, addressCountry: 'ES' },
  areaServed: 'Badalona',
  hasOfferCatalog: { '@type': 'OfferCatalog', name: ui[lang].servicios.label, itemListElement: ui[lang].servicios.items.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.t } })) },
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />
