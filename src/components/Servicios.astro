---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].servicios;
/** Iconos de línea propios (24×24). */
const iconos = [
  'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z',
  'M13 2 4 14h7l-1 8 9-12h-7z',
  'M3 17h2l1.5-5h11L19 17h2M5 17v3h3v-3M16 17v3h3v-3M7.5 12l1.6-4.2c.3-.5.8-.8 1.4-.8h3c.6 0 1.1.3 1.4.8L16.5 12M2 7l3 2M22 7l-3 2',
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0-5v5m0 8v5M3 12h5m8 0h5',
];
---
<section id="servicios" aria-labelledby="serv-t" class="scroll-mt-16">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label text-blau" data-reveal>{tx.label}</p>
        <h2 id="serv-t" class="titol mt-4 text-[clamp(2.5rem,5.6vw,5rem)]" data-reveal style="--i:1">{tx.title}</h2>
      </div>
      <p class="max-w-md text-lg text-gris lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">{tx.text}</p>
    </div>
    <ul class="mt-14 grid gap-px overflow-hidden rounded-lg bg-linia sm:grid-cols-2 lg:grid-cols-4">
      {tx.items.map((it, i) => (
        <li class="group relative bg-white p-7 transition-colors duration-300 hover:bg-blau hover:text-white" data-reveal style={`--i:${i}`}>
          <span class="font-mono text-sm text-gris group-hover:text-white/70">0{i + 1}</span>
          <svg viewBox="0 0 24 24" class="mt-8 size-12 text-blau transition-colors group-hover:text-groc" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconos[i]} /></svg>
          <h3 class="titol mt-8 text-3xl">{it.t}</h3>
          <p class="mt-3 text-gris group-hover:text-white/80">{it.d}</p>
        </li>
      ))}
    </ul>
    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3 font-semibold">
      {tx.tambien.map((t, i) => (
        <li class="flex items-center gap-2.5" data-reveal style={`--i:${i}`}><span aria-hidden="true" class="size-2.5 rotate-45 bg-groc-2"></span>{t}</li>
      ))}
    </ul>
  </div>
</section>
